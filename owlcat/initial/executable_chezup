#!/usr/bin/env bash
set -euo pipefail

BASEDIR=$(dirname "$(realpath "$0")")

# 1. Install yay if missing
if ! command -v yay >/dev/null 2>&1; then
  echo "Installing yay..."
  yaydir=$(mktemp -d)
  git clone https://aur.archlinux.org/yay-bin.git "$yaydir"
  (cd "$yaydir" && makepkg -si --noconfirm)
  rm -rf "$yaydir"
fi

cd "$BASEDIR" || {
  echo "Cannot cd to $BASEDIR"
  exit 1
}

# 2. Check files exist
[[ -f pacs ]] || {
  echo "Error: pacs file not found"
  exit 1
}
[[ -f yays ]] || {
  echo "Error: yays file not found"
  exit 1
}

# 3. Install packages
echo "Installing official packages..."
xargs -a pacs --no-run-if-empty sudo pacman -S --needed --noconfirm || true

echo "Installing AUR packages..."
xargs -a yays --no-run-if-empty yay -S --needed --noconfirm || true

# 4. Add user to groups
sudo usermod -aG realtime,gamemode,video,input,wheel "$USER"
echo "User added to groups (re-login required for changes to take effect)"

echo "Setup completed successfully"
