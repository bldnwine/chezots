#!/usr/bin/env python3
"""Give Quickshell normal CPU/I/O priority. Use --check to preview changes."""
import difflib
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile

RULE = Path('/etc/ananicy.d/00-default/DEs-and-WMs/dank-material-shell.rules')
PACMAN = Path('/etc/pacman.conf')


def edits(rule_path, pacman_path):
    old_rule = rule_path.read_text()
    lines = old_rule.splitlines(keepends=True)
    matches = 0
    for index, line in enumerate(lines):
        if not line.strip() or line.lstrip().startswith('#'):
            continue
        rule = json.loads(line)
        if rule.get('name') == 'qs':
            matches += 1
            rule.update(nice=0, ioclass='best-effort', ionice=4)
            lines[index] = json.dumps(rule) + '\n'
    if matches != 1:
        raise RuntimeError(f'Expected exactly one qs entry in {rule_path}; found {matches}')
    old_pacman = pacman_path.read_text()
    directive = 'NoUpgrade = ' + str(RULE).lstrip('/')
    new_pacman = old_pacman
    if directive not in old_pacman.splitlines():
        if old_pacman.count('[options]\n') != 1:
            raise RuntimeError('Expected one [options] section in pacman.conf')
        new_pacman = old_pacman.replace(
            '[options]\n', '[options]\n# Preserve the local Quickshell scheduling correction.\n'
            + directive + '\n', 1)
    return [(rule_path, old_rule, ''.join(lines)), (pacman_path, old_pacman, new_pacman)]


def save(path, content):
    backup = path.with_name(path.name + '.before-qs-priority')
    if not backup.exists():
        shutil.copy2(path, backup)
    original = path.stat()
    fd, temporary = tempfile.mkstemp(prefix='.' + path.name + '.', dir=path.parent)
    try:
        with os.fdopen(fd, 'w') as stream:
            stream.write(content)
            stream.flush()
            os.fchmod(stream.fileno(), original.st_mode & 0o777)
            os.fchown(stream.fileno(), original.st_uid, original.st_gid)
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def main():
    if sys.argv[1:] not in ([], ['--check']):
        print('Usage: qspriority [--check]', file=sys.stderr)
        return 2
    preview = sys.argv[1:] == ['--check']
    changes = edits(RULE, PACMAN)
    if preview:
        for path, old, new in changes:
            print(''.join(difflib.unified_diff(old.splitlines(True), new.splitlines(True),
                                              fromfile=str(path), tofile=str(path))), end='')
        if all(old == new for _, old, new in changes):
            print('Priority rule and upgrade protection are already configured.')
        return 0
    if os.geteuid() != 0:
        os.execvp('pkexec', ['pkexec', sys.executable, str(Path(__file__).resolve())])
    for path, old, new in changes:
        if old != new:
            save(path, new)
    # Reload retained stale priorities on this Ananicy version; restart instead.
    subprocess.run(['/usr/bin/systemctl', 'restart', 'ananicy-cpp.service'], check=True)
    uid = int(os.environ.get('PKEXEC_UID', os.getuid()))
    count = 0
    for process in Path('/proc').iterdir():
        if not process.name.isdigit():
            continue
        try:
            if process.stat().st_uid != uid or (process / 'comm').read_text().strip() != 'qs':
                continue
            for task in (process / 'task').iterdir():
                try:
                    os.setpriority(os.PRIO_PROCESS, int(task.name), 0)
                    result = subprocess.run(['/usr/bin/ionice', '-c', '2', '-n', '4', '-p', task.name],
                                            capture_output=True, text=True)
                    if result.returncode and task.exists():
                        raise RuntimeError(result.stderr.strip())
                except ProcessLookupError:
                    continue
            count += 1
        except FileNotFoundError:
            continue
    print(f'Configured qs: CPU nice 0, best-effort I/O priority 4; updated {count} running instance(s).')
    print('Ananicy restarted. Package updates preserve the rule; review future .pacnew files.')
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError, RuntimeError, subprocess.CalledProcessError) as error:
        print(f'qspriority: {error}', file=sys.stderr)
        sys.exit(1)
