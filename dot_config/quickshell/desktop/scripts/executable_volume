#!/bin/bash
action="$1"

# Resolve default sink and physical sink
def=$(pactl get-default-sink 2>/dev/null)
target="$def"
if [ "$def" = "effect_input.eq" ]; then
  phys=$(pactl list sinks short 2>/dev/null | awk '$2 !~ /effect_/ {print $2; exit}')
  [ -n "$phys" ] && target="$phys"
  # Keep effect_input.eq at 100% unity gain
  wpctl set-volume effect_input.eq 1.00 >/dev/null 2>&1 || true
fi

if [ "$action" = "mute" ]; then
  pamixer ${target:+--sink "$target"} -t >/dev/null
else
  pamixer ${target:+--sink "$target"} -u >/dev/null
  if [[ "$action" == +* ]]; then
    pamixer ${target:+--sink "$target"} -i "${action#+}" >/dev/null
  elif [[ "$action" == -* ]]; then
    pamixer ${target:+--sink "$target"} -d "${action#-}" >/dev/null
  elif [[ "$action" =~ ^[0-9]+$ ]]; then
    pamixer ${target:+--sink "$target"} --set-volume "$action" >/dev/null
  fi
fi

percent=$(pamixer ${target:+--sink "$target"} --get-volume 2>/dev/null || echo 0)
ismuted=$(pamixer ${target:+--sink "$target"} --get-mute 2>/dev/null || echo false)

if [ "$ismuted" = "true" ] || [ "$percent" -eq 0 ]; then
  icon="volume-muted"
else
  icon="volume-high"
fi

qs -c desktop ipc call -- osd show "{\"icon\":\"$icon\",\"value\":$percent}"
(qs -c desktop ipc call audio refresh >/dev/null 2>&1 &)
