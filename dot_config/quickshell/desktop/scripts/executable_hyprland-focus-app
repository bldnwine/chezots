#!/usr/bin/env bash
# Focus a Hyprland window by application class or title

set -euo pipefail

usage() {
  echo "Usage: hyprland-focus-app <app-name>" >&2
  exit 1
}

app=${1:-}
[[ -n $app ]] || usage

# Find window address by case-insensitive matching on class or initialClass or title
address=$(
  hyprctl clients -j 2>/dev/null |
    jq -r --arg name "${app,,}" '
      [ .[] | select(
          ((.class // "") | ascii_downcase | test($name)) or
          ((.initialClass // "") | ascii_downcase | test($name)) or
          ((.title // "") | ascii_downcase | test($name))
      ) ] | .[0].address // empty'
)

[[ -n $address ]] || exit 1

# Try Hyprland Lua dispatcher syntax first, then legacy dispatcher syntax
hyprctl dispatch "hl.dsp.focus({ window = \"address:$address\" })" >/dev/null 2>&1 || \
hyprctl dispatch focuswindow "address:$address" >/dev/null 2>&1 || true
