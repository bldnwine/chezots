#!/bin/bash
device=$(hyprctl devices -j | jq -r '.touchpads[0].name // empty')
[ -n "$device" ] || exit 1
enabled=$(hyprctl devices -j | jq -r '.touchpads[0].enabled // false')
if [ "$enabled" = "true" ]; then
  hyprctl eval "hl.device({ name = \"$device\", enabled = false })" >/dev/null
  qs ipc call -- osd show "$(jq -cn '{"icon":"touchpad","message":"Touchpad disabled"}')"
else
  hyprctl eval "hl.device({ name = \"$device\", enabled = true })" >/dev/null
  qs ipc call -- osd show "$(jq -cn '{"icon":"touchpad","message":"Touchpad enabled"}')"
fi
