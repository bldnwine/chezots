#!/usr/bin/env bash
# Bridge wallpaper updates to Quickshell native Background IPC
set -euo pipefail

TARGET="${1:-}"
[ -n "$TARGET" ] || exit 0

# Always resolve to absolute canonical path
WALLPAPER=$(realpath "$TARGET" 2>/dev/null || echo "$TARGET")
[ -f "$WALLPAPER" ] || exit 0

mkdir -p "$HOME/.config/omarchy/current"
ln -sfn "$WALLPAPER" "$HOME/.config/omarchy/current/background"

# Notify Quickshell to transition to new wallpaper with smooth diagonal wipe
qs -c desktop ipc call background set "$WALLPAPER" 2>/dev/null || true
