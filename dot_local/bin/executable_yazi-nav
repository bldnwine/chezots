#!/bin/bash

declare -A folders=(
  ["Documents"]="$HOME/Docs"
  ["sr"]="$HOME/Videos/sr"
  ["ss"]="$HOME/Pictures/ss"
  ["Projects"]="$HOME/Projects"
  ["Videos"]="$HOME/Videos"
  ["Pictures"]="$HOME/Pictures"
  [".config"]="$HOME/.config"
  [".local"]="$HOME/.local"
  ["Music"]="$HOME/Music"
  ["Downloads"]="$HOME/Downloads"
)

choice=$(printf "%s\n" "${!folders[@]}" | rofi -dmenu -p "" -i -kb-custom-1 "Alt+Return")
exit_code=$?

[[ -z "$choice" || -z "${folders[$choice]}" ]] && exit 1

if [[ $exit_code -eq 10 ]]; then
  nemo "${folders[$choice]}"
else
  ghostty -e yazi "${folders[$choice]}"
fi
